# ── Backend (jmt-admin) ───────────────────────────────────────────────
# This site has no database: all content and form submissions go through the
# jmt-admin API. Origin of jmt-admin, no trailing slash.
ADMIN_API_URL=http://localhost:3000

# Shared secret. Must be the SAME value as REVALIDATE_SECRET in jmt-admin.
# jmt-admin sends it when it asks this site to refresh after a CMS save, and
# this site sends it with lead-form submissions.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ── This site ─────────────────────────────────────────────────────────
# Public URL of this homepage. Used to build absolute social-share (og:image)
# links. No trailing slash.
SITE_URL=http://localhost:3002

# Optional. Origin of the main website. CMS links that are
# relative paths (e.g. "/blog/x") are prefixed with it; when it's empty those
# links are dropped. No trailing slash.
PRODUCTION_URL=

# Optional. Hostname(s) of jmt-admin's HOSTINGER_MEDIA_URL, comma-separated,
# no scheme (e.g. media.example.com). When set, next/image optimizes photos
# (AVIF/WebP + srcset) and only these hosts are allowed. When empty, images
# are served as uploaded and any host works. Build-time: rebuild after
# changing it. Set it in production.
# Docker: pass it as --build-arg and keep this line commented out (or give it
# the same value) in the file used with "docker run --env-file": an empty
# "MEDIA_HOSTNAMES=" there overrides the built-in value and every optimized
# image (/_next/image) returns 404.
# MEDIA_HOSTNAMES=

# Optional. 1 = keep the image optimizer off even when MEDIA_HOSTNAMES is set
# (images are served as uploaded). Build-time. Docker: same rule as above.
# DISABLE_IMAGE_OPTIMIZATION=

# ── Build ─────────────────────────────────────────────────────────────
# SITE_URL, ADMIN_API_URL, PRODUCTION_URL, MEDIA_HOSTNAMES and
# DISABLE_IMAGE_OPTIMIZATION are read by "npm run build" too (pages are
# prerendered, the image settings are baked in), so they must be set where
# the build runs, not only where the server runs. Docker: pass them as
# --build-arg (see Dockerfile). REVALIDATE_SECRET is runtime-only.

# Optional. 1 = a production build fails when ADMIN_API_URL or SITE_URL is
# missing or points at localhost. Leave empty for local builds; set it in the
# build environment of a real deployment (Docker: --build-arg REQUIRE_PROD_ENV=1).
REQUIRE_PROD_ENV=
