# ── Backend (jmt-admin) ───────────────────────────────────────────────
# This site has no database: all content and form submissions go through the
# jmt-admin API. Origin of jmt-admin, no trailing slash.
ADMIN_API_URL=http://localhost:3000

# Shared secret. Must be the SAME value as REVALIDATE_SECRET in jmt-admin.
# jmt-admin sends it when it asks this site to refresh after a CMS save, and
# this site sends it with lead-form submissions.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ── This site ─────────────────────────────────────────────────────────
# Public URL of this homepage. Used to build absolute social-share (og:image)
# links. No trailing slash.
SITE_URL=http://localhost:3002
