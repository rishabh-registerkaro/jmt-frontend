# ── Backend (jmt-admin) ───────────────────────────────────────────────
# This site has no database: all content and form submissions go through the
# jmt-admin API. Origin of jmt-admin, no trailing slash.
ADMIN_API_URL=http://localhost:3000

# Shared secret. Must be the SAME value as REVALIDATE_SECRET in jmt-admin.
# jmt-admin sends it when it asks this site to refresh after a CMS save, and
# this site sends it with lead-form submissions.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ── This site ─────────────────────────────────────────────────────────
# Public URL of this homepage. Used to build absolute social-share (og:image)
# links. No trailing slash.
SITE_URL=http://localhost:3002

# Optional. Origin of the main Global Elite website. CMS links that are
# relative paths (e.g. "/blog/x") are prefixed with it; when it's empty those
# links are dropped. No trailing slash.
PRODUCTION_URL=

# Optional. Hostname(s) of jmt-admin's HOSTINGER_MEDIA_URL, comma-separated,
# no scheme (e.g. media.example.com). When set, next/image optimizes photos
# (AVIF/WebP + srcset) and only these hosts are allowed. Build-time: rebuild
# after changing it.
MEDIA_HOSTNAMES=
